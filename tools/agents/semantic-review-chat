#!/usr/bin/env bash
# semantic-review-chat - Interactive semantic review chat for current branch vs base
#
# This is intended for HUMAN use (interactive). It generates a review prompt file
# (including AGENTS_DEBUG.md directives) and launches `acli rovodev run` so you
# can interactively discuss the PR with the agent.
#
# Usage:
#   semantic-review-chat [--base BRANCH]
#
# Defaults:
#   --base main

set -euo pipefail

BASE_BRANCH="main"

while [[ $# -gt 0 ]]; do
  case $1 in
    --base)
      BASE_BRANCH="$2"
      shift 2
      ;;
    --help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Error: not in a git repo" >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

CURRENT_BRANCH=$(git branch --show-current)
if [[ -z "$CURRENT_BRANCH" ]]; then
  echo "Error: detached HEAD" >&2
  exit 1
fi

REVIEWER_SCRIPT="$REPO_ROOT/tools/semantic_reviewer.py"
DIRECTIVES_FILE="$REPO_ROOT/tools/agents/AGENTS_DEBUG.md"

if [[ ! -f "$DIRECTIVES_FILE" ]]; then
  echo "Error: directives file not found: $DIRECTIVES_FILE" >&2
  exit 1
fi

# Store generated prompts inside the repo workspace so the agent can open them via `open_files`.
# You can override with: SEMANTIC_REVIEW_PROMPT_DIR=/path
PROMPT_DIR="${SEMANTIC_REVIEW_PROMPT_DIR:-$REPO_ROOT/tools/agents}"
mkdir -p "$PROMPT_DIR"
PROMPT_FILE="$PROMPT_DIR/semantic_review_prompt_latest.txt"

# Always keep the generated prompt file.
# This makes it easy to inspect/reuse and avoids confusion if the interactive run fails later.
KEEP_PROMPT=1
# trap is set later after CONFIG_FILE is created

# Generate prompt file for the PR
python3 "$REVIEWER_SCRIPT" \
  --directives "$DIRECTIVES_FILE" \
  --dump-prompt "$PROMPT_FILE" \
  --against "$BASE_BRANCH" \
  >/dev/null

# Validate the prompt contains actual diff content (not just directives/header).
# Be tolerant of leading whitespace/control chars.
if ! grep -qE "^[[:space:]]*diff --git" "$PROMPT_FILE"; then
  echo "Error: generated prompt does not contain any git diff hunks." >&2
  echo "Prompt path: $PROMPT_FILE" >&2
  echo "Hint: try inspecting with: sed -n '1,120p' '$PROMPT_FILE'" >&2
  echo "Changed files vs $BASE_BRANCH:" >&2
  git diff --name-only "$BASE_BRANCH"..HEAD | sed -n '1,120p' >&2
  exit 1
fi

echo "Prompt written to: $PROMPT_FILE"
echo "Prompt stats: $(wc -l <"$PROMPT_FILE") lines, $(wc -c <"$PROMPT_FILE") bytes"
echo "First diff header:"
grep -m 1 "^diff --git" "$PROMPT_FILE" || true

echo "Launching interactive RovoDev chat (base=$BASE_BRANCH, branch=$CURRENT_BRANCH)"
echo ""

# Launch interactive chat with a temporary config that preloads directives and the prompt path.
# This avoids requiring you to paste an initial message (and keeps the session interactive).
CONFIG_FILE="${TMPDIR:-/tmp}/semantic_review_chat_config_$$_$(date +%s).yml"
trap 'echo "Keeping prompt: $PROMPT_FILE" >&2; rm -f "$CONFIG_FILE"' EXIT

cat >"$CONFIG_FILE" <<EOF
version: 1
agent:
  additionalSystemPrompt: |
$(while IFS= read -r line; do
  echo "    $line"
done <"$DIRECTIVES_FILE")

    Read the PR review prompt from: $PROMPT_FILE
  streaming: true
  temperature: 0.3
  modelId: auto
EOF

echo "Using config: $CONFIG_FILE"

echo ""
acli rovodev run --config-file "$CONFIG_FILE" --yolo
