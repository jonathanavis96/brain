#!/usr/bin/env bash
set -euo pipefail

# rovodev-run-notify - Wrapper around 'acli rovodev run' with notification on completion
#
# Usage:
#   rovodev-run-notify [OPTIONS] -- [ACLI_ARGS...]
#
# Options:
#   --dry-run    Print what would be executed without running acli
#   --log FILE   Log file to scan for HUMAN_REQUIRED markers (optional)
#   --help       Show this help message
#
# Examples:
#   rovodev-run-notify -- --prompt "Fix bug" --file main.py
#   rovodev-run-notify --log loop.log -- --prompt "Test"
#   rovodev-run-notify --dry-run -- --prompt "Test"
#
# Behavior:
#   - Runs: acli rovodev run [ACLI_ARGS...]
#   - On exit 0 (SUCCESS): calls bin/notify with info level
#   - On non-zero with HUMAN_REQUIRED marker: calls bin/notify with warn level, sound, and TTS
#   - On non-zero (FAIL): calls bin/notify with error level and sound
#   - Preserves original exit code

usage() {
  sed -n '3,19p' "$0" | sed 's/^# //' | sed 's/^#//'
  exit 0
}

DRY_RUN=false
LOG_FILE=""
ACLI_ARGS=()

# Parse wrapper options before --
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help)
      usage
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --log)
      LOG_FILE="$2"
      shift 2
      ;;
    --)
      shift
      ACLI_ARGS=("$@")
      break
      ;;
    *)
      echo "Error: Unknown option '$1'" >&2
      echo "Use '--' to separate wrapper options from acli arguments" >&2
      echo "Example: rovodev-run-notify --dry-run -- --prompt 'test'" >&2
      exit 1
      ;;
  esac
done

# Get absolute paths to bin/notify and tools/detect_human_required.py
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NOTIFY_BIN="$SCRIPT_DIR/notify"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DETECT_HUMAN="$REPO_ROOT/tools/detect_human_required.py"

if [[ ! -x "$NOTIFY_BIN" ]]; then
  echo "Error: bin/notify not found or not executable: $NOTIFY_BIN" >&2
  exit 1
fi

if [[ ! -f "$DETECT_HUMAN" ]]; then
  echo "Error: tools/detect_human_required.py not found: $DETECT_HUMAN" >&2
  exit 1
fi

# Dry-run mode
if [[ "$DRY_RUN" == "true" ]]; then
  echo "=== DRY RUN ==="
  echo "Would execute: acli rovodev run ${ACLI_ARGS[*]}"
  echo ""
  echo "On SUCCESS (exit 0):"
  echo "  $NOTIFY_BIN --level info --title 'RovoDev Success' --message 'Task completed successfully'"
  echo ""
  echo "On HUMAN_REQUIRED (exit != 0 + marker detected):"
  echo "  $NOTIFY_BIN --level warn --sound --tts --title 'RovoDev - Human Required' --message 'Task requires human intervention'"
  echo ""
  echo "On FAIL (exit != 0):"
  echo "  $NOTIFY_BIN --level error --sound --title 'RovoDev Failed' --message 'Task failed with exit code X'"

  if [[ -n "$LOG_FILE" ]]; then
    echo ""
    echo "Log file: $LOG_FILE"
    if [[ -f "$LOG_FILE" ]]; then
      echo "Testing HUMAN_REQUIRED detection..."
      if python3 "$DETECT_HUMAN" "$LOG_FILE"; then
        echo "✓ HUMAN_REQUIRED marker detected in log"
      else
        echo "✗ No HUMAN_REQUIRED marker in log"
      fi
    else
      echo "Warning: Log file not found (would skip detection)"
    fi
  fi

  exit 0
fi

# Execute acli rovodev run with provided arguments
set +e
acli rovodev run "${ACLI_ARGS[@]}"
EXIT_CODE=$?
set -e

# Send notification based on exit code and HUMAN_REQUIRED detection
if [[ $EXIT_CODE -eq 0 ]]; then
  "$NOTIFY_BIN" --level info --title "RovoDev Success" --message "Task completed successfully" || true
else
  # Check for HUMAN_REQUIRED markers
  HUMAN_REQUIRED=false
  if [[ -n "$LOG_FILE" ]] && [[ -f "$LOG_FILE" ]]; then
    if python3 "$DETECT_HUMAN" "$LOG_FILE"; then
      HUMAN_REQUIRED=true
    fi
  fi

  # Send appropriate notification
  if [[ "$HUMAN_REQUIRED" == "true" ]]; then
    "$NOTIFY_BIN" --level warn --sound --tts --title "RovoDev - Human Required" --message "Task requires human intervention (exit code $EXIT_CODE)" || true
  else
    "$NOTIFY_BIN" --level error --sound --title "RovoDev Failed" --message "Task failed with exit code $EXIT_CODE" || true
  fi
fi

# Preserve original exit code
exit $EXIT_CODE
